{
  "name": "mdreview-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.2.0",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "volta": {
    "node": "26.2.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "build": "npm run verify:fonts && npm run clean:dist && npm run typecheck && vite build && npm run verify:fonts:dist",
    "clean:dist": "node scripts/clean-dist.mjs",
    "dev": "vite",
    "format": "prettier --write README.md index.html package.json package-lock.json public/fonts/README.md \"*.config.*\" \"tsconfig*.json\" \"scripts/**/*.mjs\" \"src/**/*.{css,ts,tsx}\" \"tests/**/*.{mjs,ts}\"",
    "format:check": "prettier --check README.md index.html package.json package-lock.json public/fonts/README.md \"*.config.*\" \"tsconfig*.json\" \"scripts/**/*.mjs\" \"src/**/*.{css,ts,tsx}\" \"tests/**/*.{mjs,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test:unit",
    "test:browser": "npm run build && playwright test",
    "test:go-server": "playwright test --config playwright.go-server.config.ts",
    "test:fonts": "node --test scripts/verify-fonts.test.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual": "npm run build && playwright test --config playwright.visual.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tools.json",
    "verify:fonts": "node scripts/verify-fonts.mjs public/fonts",
    "verify:fonts:dist": "node scripts/verify-fonts.mjs dist/fonts"
  },
  "dependencies": {
    "decode-named-character-reference": "1.3.0",
    "preact": "10.29.7",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@preact/preset-vite": "2.10.6",
    "@types/hast": "3.0.5",
    "@types/node": "26.1.2",
    "@types/unist": "3.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
